# Python cache and local environment files
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/

# Local database. inventory.db holds live credentials (models.py:273 — "treat the
# database file as a secret"), so match any copy, not just the default filename:
# inventory_backup.db and test.db were committable before this.
inventory.db
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
# Flask's instance folder, root-anchored so it cannot swallow templates/instance/.
/instance/

# Generated inventory/upload images
uploads/
static/uploads/
inventory_images/
generated_images/
templates/roi/

# Temporary import/scan processing folders
temp/
tmp/
temp_*/
tmp_*/
*/temp/
*/tmp/
*/temp_*/
*/tmp_*/

# Common temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db
.env

# Local TLS certificate/key (regenerated by the app on first run)
certs/

# Key and credential material, matched by EXTENSION rather than by location.
# This repo leaked a TLS private key that lived in certs/, and the response was to
# ignore that one directory (above). That only stops the mistake being repeated in
# exactly the same folder — the same file written anywhere else was still committable.
# These patterns are the part that generalises.
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
.env.*
!.env.sample
