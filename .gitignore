# Python cache and local environment files
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/

# Local database. inventory.db holds live credentials (models.py:273 — "treat the
# database file as a secret"), so match any copy, not just the default filename:
# inventory_backup.db and test.db were committable before this.
inventory.db
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
# Flask's instance folder, root-anchored so it cannot swallow templates/instance/.
/instance/

# Generated inventory/upload images
uploads/
static/uploads/
inventory_images/
generated_images/
templates/roi/

# Temporary import/scan processing folders
temp/
tmp/
temp_*/
tmp_*/
*/temp/
*/tmp/
*/temp_*/
*/tmp_*/

# Common temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db
.env

# Local TLS certificate/key (regenerated by the app on first run)
certs/

# Key and credential material, matched by EXTENSION rather than by location.
# This repo leaked a TLS private key that lived in certs/, and the response was to
# ignore that one directory (above). That only stops the mistake being repeated in
# exactly the same folder — the same file written anywhere else was still committable.
# These patterns are the part that generalises.
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
.env.*
!.env.sample

# Migration bundles, matched by NAME rather than by location — the same reasoning as
# the key patterns above. These carry FLASK_SECRET_KEY, marketplace OAuth tokens and
# the mailbox password (app.py:7010 says so), and today they are ignored only because
# UPLOAD_FOLDER happens to default to uploads/. /settings/storage lets an admin
# repoint that root at any folder that is not an ancestor of the app — including one
# INSIDE the repo, e.g. ./card_data — and the bundles were committable from there.
# This repo has already published secrets once by committing them.
migration_exports/
ccim_migration_*.tar.gz

# Local storage layout written next to app.py. Not a secret, but it describes this
# install's directory paths and is never meant to be shared. Root-anchored so it
# cannot swallow a same-named file elsewhere in the tree.
/storage_config.json

# Per-install system state written next to app.py by the app itself (system mode,
# unlimited native-import toggle, identification provider). A committed copy
# pre-answers the first-run Sorting Machine vs Dedicated Server chooser for every
# fresh clone, which is how one install's mode ended up shipped to everyone.
# Root-anchored for the same reason as storage_config.json above.
/system_config.json
